fixtures/saves/
__pycache__/
*.pyc
backups/
logs/
tmp/
.env
# generated league sites are rebuilt from the saves on every publish
site/leagues/
# Rebuilt from the live exports on every publish.
site/data/stories.json

# Live character data, not source. It is the store when Supabase is not configured, so it holds
# real people's players once anybody signs up - it does not belong in a public repository.
universe/local_store.json
# ...and every copy of it. `git add -A` swept a *.bak aside-copy into a public repo
# once; the store holds real characters and real owner ids.
universe/local_store*.json*
universe/sim_runs.json
universe/run_in_progress.json

# Permanent OS lock shared by save operations. Never delete while services run.
universe/.save-operation.lock
