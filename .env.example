# Cheezeyverse commissioner - local configuration.
#
# Copy this file to `.env` in the project root and fill it in. `.env` is gitignored and
# must stay that way: SUPABASE_SERVICE_KEY bypasses every Row Level Security policy in
# the database, so anyone holding it can rewrite any character's ratings.
#
#   copy .env.example .env      (cmd)
#   cp .env.example .env        (git bash)
#
# Read by commissioner/settings.py. A real environment variable always wins over a line
# here. Nothing in this project requires the file to exist - without it the codec, the
# driver and the universe generator all still run, and commissioner/store.py raises
# StoreNotConfigured only when something actually tries to talk to Supabase.

# Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API -> Project API keys -> service_role
# NOT the anon key. The anon key is the one that goes in site/config.js.
SUPABASE_SERVICE_KEY=paste-the-service-role-key-here

# Seconds before an HTTPS call to Supabase gives up. Optional.
SUPABASE_TIMEOUT=20

# ---------------------------------------------------------------- Discord (optional)
# An incoming webhook, so the server hears about sims as they happen instead of somebody
# having to say so. Make it in Discord: Server Settings -> Integrations -> Webhooks -> New
# Webhook, pick the channel, Copy Webhook URL.
#
# Treat it like a password. Anybody holding this URL can post to your server as the
# commissioner. It belongs here in .env, which is gitignored, and nowhere else - the
# notifier never logs it, so a failure names the status code rather than the address.
#
# Leave it unset and nothing is posted. That is a normal universe, not a broken one.
DISCORD_WEBHOOK_URL=

# The public site, used only to link to it from those messages. Unset means no link.
SITE_URL=https://waligug.github.io/cheezeyverse/

# Optional dedicated channel for manually scanned statistical feats
DISCORD_FEATS_WEBHOOK_URL=
